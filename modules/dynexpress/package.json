{
  "name": "dynexpress",
  "version": "2.0.0",
  "description": "Next-generation multi-server dynamic Express orchestrator with hot-reloading, fluent route builders, socket lifecycle tracking, live telemetry, and zero-downtime port rebinding.",
  "main": "./main.mjs",
  "module": "./main.mjs",
  "types": "./index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./main.mjs",
      "default": "./main.mjs"
    }
  },
  "files": [
    "main.mjs",
    "index.d.ts",
    "utils/**/*",
    "README.md",
    "LICENSE"
  ],
