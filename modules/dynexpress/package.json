  },
  "bugs": {
    "url": "https://github.com/devlwte/dynexpress/issues"
  },
  "homepage": "https://github.com/devlwte/dynexpress#readme",
  "keywords": [
    "express",
    "dynamic-express",
    "multi-server",
    "hot-reload",
    "route-builder",
    "telemetry",
